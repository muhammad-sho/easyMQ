# easyMQ environment configuration — OPTIONAL.
# Normal Docker deployment needs no `.env` file. Application defaults are
# production-safe; the image defaults REDIS_URL to the Compose Redis service.
# Copy this file only when you want to override defaults. Values are
# validated at startup; the process fails fast on invalid configuration.

# --- Redis ---
# Connection URL for Redis (BullMQ backend + easyMQ discovery index).
# Default outside Docker: redis://127.0.0.1:6379
# Default in the published image: redis://redis:6379 (Compose service name)
REDIS_URL=redis://127.0.0.1:6379
# Key prefix for BullMQ keys and easyMQ's own keys (queues index, markers,
# auto-managed API token).
REDIS_KEY_PREFIX=easymq

# --- API ---
API_HOST=0.0.0.0
# Port the HTTP API listens on. Use 0 only for tests (ephemeral port).
API_PORT=3000
# Bearer token for all API routes except /health/*.
# Optional: when unset and the API is served, easyMQ generates a random
# token on first start and persists it in Redis (stable while Redis data
# lives). The token is printed in startup logs. Set API_TOKEN to pin your
# own value (recommended for multi-instance / external secret managers).
API_TOKEN=
# Development-only bypass. NEVER set true in production.
AUTH_DISABLED=false

# --- Roles ---
# api | worker | both. API instances never create BullMQ Workers;
# worker instances never listen for HTTP. Default: both.
APP_ROLE=both
# Concurrent jobs per queue, per worker instance.
WORKER_CONCURRENCY=10

# --- HTTP executor ---
# Default per-request timeout (ms). Overridable per job via timeoutMs.
HTTP_TIMEOUT_MS=30000
# Maximum accepted response body size in bytes.
HTTP_MAX_RESPONSE_BYTES=1048576
# Maximum number of redirects followed per execution.
HTTP_MAX_REDIRECTS=5
# Allow calling loopback/private/link-local destinations (needed when your
# targets are internal services). Metadata-service IPs stay blocked always.
HTTP_ALLOW_PRIVATE_NETWORK=false

# --- Cancellation ---
# TTL (seconds) for distributed cancellation markers.
CANCELLATION_TTL_SECONDS=300

# --- Shutdown ---
# Grace period (ms) for active jobs to finish on SIGTERM/SIGINT.
SHUTDOWN_TIMEOUT_MS=30000

# --- Logging ---
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Human-readable logs (development). Production default is JSON.
LOG_PRETTY=false

# --- Queue/job defaults ---
DEFAULT_ATTEMPTS=3
DEFAULT_BACKOFF_TYPE=exponential
DEFAULT_BACKOFF_DELAY_MS=5000
# Retention of finished jobs (BullMQ removeOnComplete/removeOnFail counts).
DEFAULT_REMOVE_ON_COMPLETE_COUNT=1000
DEFAULT_REMOVE_ON_FAIL_COUNT=5000

# --- API pagination ---
PAGE_DEFAULT_LIMIT=50
PAGE_MAX_LIMIT=200
